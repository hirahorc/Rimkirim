# Rimkirim — environment variables
# Copy to `.env.local` for local development. Real values live in the Vercel
# dashboard (Project → Settings → Environment Variables), scoped per environment.

# Which environment the running app reports (see lib/env.ts).
#   Production environment   -> production
#   staging branch (Preview) -> staging
# Unset locally falls back to "development".
NEXT_PUBLIC_APP_ENV=development
